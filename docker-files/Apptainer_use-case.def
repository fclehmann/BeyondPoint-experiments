Bootstrap: docker
From: nvidia/cuda:11.3.1-base-ubuntu20.04


%setup
mkdir ${APPTAINER_ROOTFS}/opt/poetry-cache
mkdir ${APPTAINER_ROOTFS}/opt/app
mkdir -p ${APPTAINER_ROOTFS}/opt/app/use_cases/simpsons

%files
./lib /opt/app/
./use_cases/simpsons/src /opt/app/use_cases/simpsons/
./use_cases/simpsons/poetry.lock /opt/app/use_cases/simpsons/
./use_cases/simpsons/pyproject.toml /opt/app/use_cases/simpsons/
./use_cases/simpsons/README.md /opt/app/use_cases/simpsons/

%environment
. /opt/app/use_cases/simpsons/.venv/bin/activate

%post
PYTHON_VERSION=3.9.5

POETRY_VERSION=1.3.0
POETRY_HOME="/opt/poetry"
POETRY_CACHE_DIR="/opt/poetry-cache"
POETRY_VIRTUALENVS_CREATE=true
POETRY_VIRTUALENVS_IN_PROJECT=true
POETRY_VIRTUALENVS_PREFER_ACTIEV_PYTHON=true
POETRY_NO_INTERACTION=1

APP_HOME="/opt/app"

DEBIAN_FRONTEND=noninteractive
 # Set timezone to Etc/UTC for tzdata.
TZ=Etc/UTC
ln -snf /usr/share/zoneinfo/$TZ /etc/localtime
echo $TZ > /etc/timezone

# Install git (for spock), python and poetry
apt-get update -y
apt-get install -y git curl build-essential checkinstall liblzma-dev  libreadline-gplv2-dev libncursesw5-dev libssl-dev libsqlite3-dev tk-dev libgdbm-dev libc6-dev libbz2-dev libffi-dev zlib1g-dev
cd /usr/src
curl https://www.python.org/ftp/python/$PYTHON_VERSION/Python-$PYTHON_VERSION.tgz --output Python-$PYTHON_VERSION.tgz --silent
tar xzf Python-$PYTHON_VERSION.tgz
cd Python-$PYTHON_VERSION
./configure --prefix=/usr
make
make install
rm -rf /var/lib/apt/lists/*

python3 --version

curl -sSL https://install.python-poetry.org | POETRY_HOME=$POETRY_HOME python3 - --version $POETRY_VERSION

# Add poetry to PATH
PATH="$POETRY_HOME/bin:${PATH}"

poetry --version

cd $APP_HOME/use_cases/simpsons

python3 -m venv ./.venv
. .venv/bin/activate

poetry install

%runscript
exec python -m simpsons "$@"