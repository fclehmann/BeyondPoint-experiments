FROM python:3.9 as build

ARG POETRY_VERSION=1.3.0

ENV POETRY_VIRTUALENVS_CREATE=true \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    POETRY_HOME="/opt/poetry"

RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=$POETRY_HOME python - --version $POETRY_VERSION
ENV PATH="$POETRY_HOME/bin:${PATH}"

COPY ./tools/experiment_runner /experiment_runner

WORKDIR /experiment_runner

RUN --mount=type=cache,target="/root/.cache/pypoetry" poetry install

FROM python:3.9-slim

RUN apt-get update -y &&  \
    apt-get install -y git ssh curl wget &&  \
    apt-get autoremove -y && \
    apt-get clean

COPY --from=build /experiment_runner /experiment_runner

ENV PATH="/experiment_runner/.venv/bin:$PATH"

ENTRYPOINT ["python", "-m", "experiment_runner"]
CMD ["--help"]


