source /etc/profile > /dev/null 2>&1; curl https://gist.githubusercontent.com/RikiTikkiTavi/5f21a4d7f3e64911a6866b0e7f1a6749/raw/omniopt_install_script.sh 2>/dev/null | /bin/bash -s -- \
